{
  "name": "conveyor-guard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "system": "node scripts/start-system.mjs",
    "build": "vite build --configLoader runner",
    "lint": "oxlint",
    "preview": "vite preview",
    "system:hardware": "node scripts/start-system.mjs --hardware",
    "demo": "node scripts/start-system.mjs --demo",
    "test": "npm --prefix server test",
    "check": "npm run lint && npm --prefix server run check && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
